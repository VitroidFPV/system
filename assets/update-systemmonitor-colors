#!/usr/bin/env bash

set -eu

accent=$(kreadconfig6 \
    --file kdeglobals \
    --group 'Colors:Selection' \
    --key BackgroundNormal)

if [[ ! $accent =~ ^#[[:xdigit:]]{6}$ ]]; then
    printf 'Invalid KDE highlight color: %s\n' "$accent" >&2
    exit 1
fi

hex=${accent#\#}
printf -v sensor_color '%d,%d,%d' \
    "$((16#${hex:0:2}))" \
    "$((16#${hex:2:2}))" \
    "$((16#${hex:4:2}))"

if command -v qdbus6 >/dev/null 2>&1; then
    qdbus_command=qdbus6
elif command -v qdbus-qt6 >/dev/null 2>&1; then
    qdbus_command=qdbus-qt6
elif [[ -x /usr/lib64/qt6/bin/qdbus ]]; then
    qdbus_command=/usr/lib64/qt6/bin/qdbus
else
    printf 'Could not find a Qt 6 qdbus executable.\n' >&2
    exit 1
fi

plasma_script=$(cat <<EOF
const accent = "$sensor_color";
let widgetsUpdated = 0;
let colorsUpdated = 0;

for (const containment of desktops().concat(panels())) {
    for (const widgetId of containment.widgetIds) {
        const widget = containment.widgetById(widgetId);
        if (!widget.type.startsWith("org.kde.plasma.systemmonitor")) {
            continue;
        }

        widget.currentConfigGroup = ["SensorColors"];
        const colorKeys = widget.configKeys;
        if (colorKeys.length === 0) {
            continue;
        }

        for (const colorKey of colorKeys) {
            widget.writeConfig(colorKey, accent);
            colorsUpdated++;
        }
        widget.reloadConfig();
        widgetsUpdated++;
    }
}

print("Updated " + colorsUpdated + " sensor color(s) in "
    + widgetsUpdated + " System Monitor widget(s) to " + accent);
EOF
)

"$qdbus_command" \
    org.kde.plasmashell \
    /PlasmaShell \
    org.kde.PlasmaShell.evaluateScript \
    "$plasma_script"
